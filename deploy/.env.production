# Terraform Agent 生产环境配置
# 请将此文件复制到服务器 /opt/terraform-agent/.env 并填入实际值

# LLM 配置
LLM_PROVIDER=tongyi
TONGYI_API_KEY=your_tongyi_api_key_here
# VLLM_ENDPOINT=http://localhost:8000/v1
# VLLM_MODEL_NAME=Qwen2.5-14B-Instruct

# 阿里云凭据
ALICLOUD_ACCESS_KEY=your_aliyun_access_key_here
ALICLOUD_SECRET_KEY=your_aliyun_secret_key_here
ALICLOUD_REGION=cn-hangzhou

# OSS 后端配置
OSS_BUCKET=terraform-agent-state

# Azure 凭据
ARM_CLIENT_ID=
ARM_CLIENT_SECRET=
ARM_SUBSCRIPTION_ID=
ARM_TENANT_ID=
ARM_LOCATION=eastasia

# Azure 状态后端
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_CONTAINER=tfstate

# Ansible 配置
SSH_PRIVATE_KEY_PATH=
SSH_USER=root
ANSIBLE_CONTAINER_IMAGE=terraform-agent-ansible-runner:latest